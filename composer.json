{
  "name": "shevartv/mxapi3-dev",
  "description": "Инструменты разработки mxApi (MODX 3): тесты ядра без поднятия MODX",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload-dev": {
    "psr-4": {
      "MxApi\\Tests\\": "tests/"
    },
    "files": [
      "core/components/mxapi/vendor/autoload.php"
    ]
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
